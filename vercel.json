{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/writing/:slug(agents-services-bad-memory|cfs-cpu-throttling-post-mortem|deterministic-outbox-kafka-cdc|distributed-locks-are-a-lie|evals-before-models|gpu-memory-virtual-paging|head-of-line-blocking-llm-batching|p99-tail-latency-tax|quantization-without-tears|reciprocal-rank-fusion-real-world|why-rag-hallucinates-chunking)",
      "destination": "/writing",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "personal-site-six-lovat-75.vercel.app"
        }
      ],
      "destination": "https://s-maharajan.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-0F6LJx+6EaT64+eSnjqfesDLod9O8x1g2utO5rLLAYg='; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
